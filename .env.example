PORT=3200
APP_ORIGIN=http://localhost:3200
POCKETBASE_URL=http://127.0.0.1:8090
# Required only for issuing/authenticating/revoking scoped integration keys.
# Store production values in Google Secret Manager, never GitHub or browser code.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
# Must match the PocketBase ev_jobs create rule. Default: 10%.
PLATFORM_FEE_BPS=1000
# Use 1 only behind exactly one trusted proxy, such as the configured Cloud Run ingress.
TRUST_PROXY_HOPS=0
